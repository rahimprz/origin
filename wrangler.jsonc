// Cloudflare Workers (static assets). Build with `npm run build`, deploy with `npx wrangler deploy`.
// "single-page-application" sends every unknown path to index.html so React Router can handle it.
// Do not add a `/* /index.html 200` rule to public/_redirects: Cloudflare rejects it as an infinite loop.
{
  "name": "origin",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
